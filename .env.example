# Gemini API Key (required for Gemini embeddings & answer generation)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL + pgvector connection string
# Leave blank when USE_EMBEDDED_PG=true to automatically boot local embedded Postgres (pgserver)
# Or set to Docker / Neon / Supabase URL: postgresql://rag_user:rag_password@localhost:5432/rag_db
DATABASE_URL=
USE_EMBEDDED_PG=true
EMBEDDED_PG_DATA_DIR=.pgdata

# Model Configuration
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GENERATION_MODEL=gemini-3.5-flash-lite
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval & RRF Hyperparameters
RRF_K=60
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=1.0
DEFAULT_CANDIDATE_POOL=20
DEFAULT_TOP_K=5

# Context Selection & Citation Thresholds
RERANK_MIN_SCORE=0.25
RERANK_RELATIVE_FACTOR=0.60
RERANK_MAX_CHUNKS=3
RERANK_ABSTAIN_SCORE=0.25
CITATION_MIN_SIMILARITY=0.25
MIN_SPARSE_SCORE=0.05
MIN_CHUNK_TOKENS=80

# Production / Public Demo Security
DEMO_MODE=false
ADMIN_TOKEN=your_admin_token_here
ALLOWED_ORIGINS=http://127.0.0.1:8000
